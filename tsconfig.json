{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@acdh-oeaw/tsconfig"],
  "include": [],
  "files": [],
  "references": [
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.app.json"
    }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    // @see https://github.com/microsoft/TypeScript/issues/58975
    "module": "ESNext",
    "esModuleInterop": true,
  }
}